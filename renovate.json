{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "tasiomind Umbrel Community App Store: controlled container + manifest updates. Every change lands as a PR, majors never merge without a compat check.",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "schedule": ["every weekend"],
  "labels": ["dependencies"],
  "automerge": false,
  "prConcurrentLimit": 6,
  "packageRules": [
    {
      "description": "Minor/patch container updates: one PR per app, manual merge after CI + persistence check.",
      "matchManagers": ["docker-compose", "regex"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "labels": ["dependencies"],
      "automerge": false
    },
    {
      "description": "Major upgrades: NEVER auto-merge. Require umbrelOS compat check + data-persistence verification.",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major", "needs-compat-check"],
      "automerge": false,
      "prBodyNotes": [
        "⚠️ Major upgrade: verify umbrelOS 2.x compatibility, manifest conventions, and data-directory persistence before merging."
      ]
    },
    {
      "description": "Security-driven updates get priority labelling.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch"],
      "labels": ["dependencies", "security"]
    }
  ],
  "regexManagers": [
    {
      "description": "Keep tasiomind-n8n manifest version in sync with the n8n container.",
      "fileMatch": ["(^|/)tasiomind-n8n/umbrel-app\\.yml$"],
      "matchStrings": ["version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "n8nio/n8n",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Keep tasiomind-anythingllm manifest version in sync with the AnythingLLM container.",
      "fileMatch": ["(^|/)tasiomind-anythingllm/umbrel-app\\.yml$"],
      "matchStrings": ["version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "mintplexlabs/anythingllm",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Keep tasiomind-ollama manifest version in sync with the Ollama container.",
      "fileMatch": ["(^|/)tasiomind-ollama/umbrel-app\\.yml$"],
      "matchStrings": ["version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "ollama/ollama",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Keep tasiomind-grafana manifest version in sync with the Grafana container.",
      "fileMatch": ["(^|/)tasiomind-grafana/umbrel-app\\.yml$"],
      "matchStrings": ["version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "grafana/grafana",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Keep tasiomind-uptime-kuma manifest version in sync with the Uptime Kuma container.",
      "fileMatch": ["(^|/)tasiomind-uptime-kuma/umbrel-app\\.yml$"],
      "matchStrings": ["version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "louislam/uptime-kuma",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Keep tasiomind-neo4j manifest version in sync with the Neo4j LTS container.",
      "fileMatch": ["(^|/)tasiomind-neo4j/umbrel-app\\.yml$"],
      "matchStrings": ["version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "neo4j",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
